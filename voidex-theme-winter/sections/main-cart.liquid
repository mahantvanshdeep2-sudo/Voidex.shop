<section class="vx-section vx-cartpage">
  <h1 class="vx-title">Your Cart</h1>
  {%- if cart.item_count == 0 -%}
    <p class="vx-empty">Your cart is empty.</p>
    <p class="vx-center"><a class="vx-btn vx-btn--gold" href="{{ routes.all_products_collection_url }}">Continue shopping</a></p>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="vx-cart-form">
      <ul class="vx-lines">
        {%- for item in cart.items -%}
          <li class="vx-line">
            <a class="vx-line__img" href="{{ item.url }}">{%- if item.image -%}{%- assign i_alt = item.product.title | split: ' — ' | first -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: i_alt }}{%- endif -%}</a>
            <div class="vx-line__info">
              <a class="vx-line__title" href="{{ item.url }}">{{ item.product.title | split: ' — ' | first | escape }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="vx-line__variant">{{ item.variant.title | escape }}</p>{%- endunless -%}
              {%- for discount in item.line_level_discount_allocations -%}<p class="vx-line__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{%- endfor -%}
              <a class="vx-line__remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
            <label class="vx-visually-hidden" for="qty-{{ item.key }}">Quantity</label>
            <input class="vx-line__qty" id="qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
            <span class="vx-line__price">{{ item.final_line_price | money }}</span>
          </li>
        {%- endfor -%}
      </ul>
      <div class="vx-cart-summary">
        {%- for discount in cart.cart_level_discount_applications -%}<p class="vx-line__discount">{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</p>{%- endfor -%}
        <p class="vx-cart-total">Subtotal <strong>{{ cart.total_price | money_with_currency }}</strong></p>
        <p class="vx-cart-note">Taxes, duties and shipping for your country are shown at checkout. Discount codes can be entered at checkout.</p>
        <div class="vx-cart-actions">
          <button type="submit" name="update" class="vx-btn vx-btn--ghost">Update cart</button>
          <button type="submit" name="checkout" class="vx-btn vx-btn--gold">Checkout</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</section>
{% schema %}
{ "name": "Cart", "tag": "div", "settings": [] }
{% endschema %}
