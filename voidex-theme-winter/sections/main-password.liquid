<section class="vx-section vx-center vx-narrow">
  <p class="vx-logo vx-password-logo">VØIDEX</p>
  <h1 class="vx-title">Opening soon</h1>
  {%- if shop.password_message != blank -%}<p class="vx-sub">{{ shop.password_message | escape }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'vx-email__form' -%}
    {{ form.errors | default_errors }}
    <label class="vx-visually-hidden" for="vx-pw">Password</label>
    <input id="vx-pw" type="password" name="password" placeholder="Store password" autocomplete="current-password">
    <button class="vx-btn vx-btn--gold" type="submit">Enter</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Password", "tag": "div", "settings": [] }
{% endschema %}
