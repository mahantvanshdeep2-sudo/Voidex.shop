<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="vx-no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1e4f78">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
    {%- if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- if request.page_type == 'product' %}
      <meta property="og:type" content="product">
      <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
      <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
    {%- else %}
      <meta property="og:type" content="website">
    {%- endif %}
    {%- if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif %}
    {%- if page_image %}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif %}
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap">
    {{ 'voidex-perfume.css' | asset_url | stylesheet_tag }}
    {{ 'voidex-winter.css' | asset_url | stylesheet_tag }}

    <script>
      /* Motion is opt-in: content is only hidden for reveal animations once JS has
         confirmed it can show it again. If voidex-perfume.js never boots, the
         failsafe strips vx-motion and every section renders fully visible. */
      (function () {
        var d = document.documentElement;
        d.className = d.className.replace('vx-no-js', 'vx-js');
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) d.classList.add('vx-motion');
        window.__vxFailsafe = setTimeout(function () { d.classList.remove('vx-motion'); }, 3000);
      })();
      window.VX = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }}
        },
        moneyFormat: {{ shop.money_format | strip_html | json }}
      };
    </script>
    <script src="{{ 'voidex-perfume.js' | asset_url }}" defer></script>
    <script src="{{ 'voidex-winter.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="vx-body">
    <a class="vx-skip" href="#vx-main">Skip to content</a>
    <div class="vx-progress" aria-hidden="true"><span data-vx-progress></span></div>
    <div class="vx-aurora" aria-hidden="true"></div>
    <canvas class="vx-particles" data-vx-snow aria-hidden="true"></canvas>

    {% section 'voidex-perfume-announcement' %}
    {% section 'voidex-perfume-header' %}

    <main id="vx-main" class="vx-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'voidex-perfume-footer' %}

    <div class="vx-toast" data-vx-toast role="status" aria-live="polite" hidden>
      <p class="vx-toast__msg" data-vx-toast-msg></p>
      <div class="vx-toast__actions">
        <a class="vx-toast__link" href="{{ routes.cart_url }}">View cart</a>
        <a class="vx-toast__link vx-toast__link--gold" href="/checkout">Checkout</a>
      </div>
    </div>
  </body>
</html>
